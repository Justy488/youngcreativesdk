---
import Button from "./Button.astro";
import { Image } from "astro:assets";
import Herobillede from "../../assets/YCDK_Secondary_logo_Wht.svg";
import Herologonavn from "../../assets/YCDK_Primary_logo_Wht.svg";
---

<section class="hero">
  <!-- Video baggrund - Aktiveres her kan, udkommenteres -->
  <video class="hero-video" autoplay muted loop playsinline>
    <source src="/video/promo.mp4" type="video/mp4" />
  </video>

  <nav>
    <Image src={Herobillede} alt="YC DK Logo" />
    <Button>KONTAKT OS</Button>
  </nav>

  <!-- Hero indholdet (titel og tekst) -->
  <div class="hero-content">
    <Image src={Herologonavn} alt="YC DK Logo" class="svgændring" />

    <p class="hero-subtitle">
      Broen mellem nye talenter og den etablerede kreative branche.
    </p>
  </div>
</section>

<style>
  .svgændring {
    width: clamp(300px, 50vw, 500px);
    margin-bottom: 2rem;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden; /* VIGTIGT: Forhindrer video overflow */

    /* Hero fylder alle 3 kolonner (hele bredden), placering af elementer på heroen.  */
    grid-column: 1 / -1;
    display: grid; /* Hero har sit eget grid system indeni */
    grid-template-columns: 1fr min(1200px, 90%) 1fr;
    grid-template-rows: auto 1fr;

    color: white;
  }

  /* Styling af videoen */
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 0;
  }

  /* Overlay for at gøre baggrund mørkere */
  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(150, 100, 180, 0.15) 0%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 1;
  }

  /* Navigation, i midterste kolonne */
  nav {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    grid-column: 2;
    margin-top: 48px;
    gap: 2rem;
  }

  /* Logo styling */
  nav img {
    height: 60px;
    width: auto;
  }

  /* Hero content,  i midterste kolonne, placeringsændring */
  .hero-content {
    position: relative;
    z-index: 10;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem 0;
  }

  /* Underteksten på under svg logoet */
  .hero-subtitle {
    font-family: "Montserrat", sans-serif;
    font-weight: 400;
    font-size: clamp(1rem, 2vw, 1.25rem);
    max-width: 500px;
    line-height: 1.6;
    opacity: 0.95;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }

    nav {
      grid-column: 1;
      margin: 24px 24px 0;
    }

    .hero-content {
      grid-column: 1;
      padding: 2rem 1rem;
    }

    nav img {
      height: 40px;
    }

    .svgændring {
      width: clamp(250px, 80vw, 400px);
    }
  }
</style>
