    <h2>Klar til at tage næste skridt i din kreative karriere</h2>

    <Button buttonText="TILMELD DIG HER" type="secondary" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh; /* fylder hele skærmen */
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* beskærer korrekt */
    object-position: center;
    z-index: 0;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 70, 85, 0.65); /* blå tone */
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;

    padding: 0 20px;
  }

  h2 {
    color: white;
    font-size: clamp(1.8rem, 5vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 2em;
    margin-top: 1em;
    text-wrap-style: balance;
  }
</style>
