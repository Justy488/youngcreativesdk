---
import { Image } from "astro:assets";
const { title } = Astro.props;
const { text } = Astro.props;
const { placeholder3 } = Astro.props;
---

<section class="feature3">
  <Image src={placeholder3} alt="text" class="placeholder3" />
  <div class="content3">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
</section>

<style>
  .placeholder3 {
    width: 445px;
    height: 620px;
    object-fit: cover;
    border-radius: 3rem;
  }
  .content3 {
    justify-content: center;
    text-align: left;
  }
  .feature3 {
    gap: 1rem;
    margin: 0.5rem;
  }
</style>
